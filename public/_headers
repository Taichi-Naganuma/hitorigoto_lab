# Mananect — cache policy（Workers Assets・_headers は連結されるので path を重ねない）
# HTML ページ（ルート面）＝エッジキャッシュしない＝デプロイ即反映
/
  Cache-Control: no-store
/ja/*
  Cache-Control: no-store
/en/*
  Cache-Control: no-store
/articles/*
  Cache-Control: no-store
# ハッシュ付き不変資産＝長期キャッシュ（HTMLパスと重ならないので連結しない）
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
